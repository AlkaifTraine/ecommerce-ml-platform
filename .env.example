# Copy to .env and adjust. .env is gitignored.

# ---- storage roots (keep on D: - C: has limited free space) ----
DATA_ROOT=D:/ecommerce-ml-platform/data
DUCKDB_TEMP_DIR=D:/ecommerce-ml-platform/data/.duckdb_tmp
DUCKDB_MEMORY_LIMIT=8GB

# ---- source dataset ----
KAGGLE_DATASET=mkechinov/ecommerce-behavior-data-from-multi-category-store

# ---- OLTP ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=storefront
POSTGRES_USER=storefront
POSTGRES_PASSWORD=change_me_locally

# ---- online feature store ----
REDIS_URL=redis://localhost:6379/0

# ---- tracking ----
MLFLOW_TRACKING_URI=http://localhost:5000

# ---- replayer clock ----
# how many seconds of DATA time pass per second of WALL time
REPLAY_SPEED=100000
# events at or before this timestamp are loaded fast to bootstrap the system
REPLAY_BACKFILL_UNTIL=2019-11-20T00:00:00
